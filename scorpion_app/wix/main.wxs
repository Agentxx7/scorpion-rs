<!--
  SCORPION_WINDOWS_INSTALLABLE_APPLICATION_001

  This file is a hand-customized `cargo wix` template (the base skeleton,
  License.rtf text, UpgradeCode, and the "PlatformProgramFilesFolder"
  preprocessor block were generated for real by `cargo wix print wxs`/
  `cargo wix print MIT` against this exact package's Cargo.toml — see
  scorpion_app/Cargo.toml's `authors`/`license`/`description` fields —
  never hand-typed license text or an invented GUID). Customizations on
  top of the generated skeleton:

  - a second binary component for scorpion-launcher.exe (the thin
    startup orchestrator — see scorpion_app/src/bin/scorpion_launcher.rs)
  - a Start Menu shortcut and a Desktop shortcut, both launching
    scorpion-launcher.exe, never scorpion-api.exe directly and never a
    terminal command
  - the generated template's "add install directory to PATH" Environment
    component/Feature removed: this is a GUI launcher application, not a
    command-line tool meant to be invoked from an arbitrary shell
  - WixUI_FeatureTree (a component-selection tree) replaced with the
    simpler WixUI_Minimal, since there is exactly one, non-optional
    Feature and no meaningful per-component selection to expose

  UpgradeCode is permanently pinned below (must never change across
  future versions of this installer, or Windows Installer will treat
  upgrades as unrelated products and install side by side instead of
  upgrading in place).

  Path note (found the hard way, on real Windows CI): `cargo wix`
  itself locates this file relative to the target package's own
  manifest directory (`scorpion_app\`), but `candle.exe`/`light.exe`
  resolve every relative `Source`/`Value` *inside* this file relative
  to whatever directory the `cargo wix` process itself was launched
  from — the workspace root, in .github/workflows/windows-package.yml.
  So every path below is written as `scorpion_app\wix\...`, not the
  bare `wix\...` cargo-wix's own generated template uses by default
  (correct only for a non-workspace, single-crate project where those
  two directories are the same one).
-->

<!--
  The "cargo wix" subcommand provides a variety of predefined variables available
  for customization of this template. The values for each variable are set at
  installer creation time. The following variables are available:

  TargetTriple      = The rustc target triple name.
  TargetEnv         = The rustc target environment. This is typically either
                      "msvc" or "gnu" depending on the toolchain downloaded and
                      installed.
  TargetVendor      = The rustc target vendor. This is typically "pc", but Rust
                      does support other vendors, like "uwp".
  CargoTargetBinDir = The complete path to the directory containing the
                      binaries (exes) to include. The default would be
                      "target\release\". If an explicit rustc target triple is
                      used, i.e. cross-compiling, then the default path would
                      be "target\<CARGO_TARGET>\<CARGO_PROFILE>",
                      where "<CARGO_TARGET>" is replaced with the "CargoTarget"
                      variable value and "<CARGO_PROFILE>" is replaced with the
                      value from the "CargoProfile" variable. This can also
                      be overridden manually with the "target-bin-dir" flag.
  CargoTargetDir    = The path to the directory for the build artifacts, i.e.
                      "target".
  CargoProfile      = The cargo profile used to build the binaries
                      (usually "debug" or "release").
  Version           = The version for the installer. The default is the
                      "Major.Minor.Fix" semantic versioning number of the Rust
                      package.
-->

<!--
  Please do not remove these pre-processor If-Else blocks. These are used with
  the `cargo wix` subcommand to automatically determine the installation
  destination for 32-bit versus 64-bit installers. Removal of these lines will
  cause installation errors.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='Scorpion'
        UpgradeCode='96EFB8D0-ED36-4514-B972-5E7725FEA1DF'
        Manufacturer='Scorpion'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Scorpion Web Console and IAM Callback Inspector - local evidence-first web crawling, research, and IAM diagnostics.'
            Manufacturer='Scorpion'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='Scorpion Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Scorpion'>
                    <!--
                      Disabling the license sidecar file in the installer is a two step process:

                      1. Comment out or remove the `Component` tag along with its contents.
                      2. Comment out or remove the `ComponentRef` tag with the "License" Id
                         attribute value further down in this file.
                    -->
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            DiskId='1'
                            Source='scorpion_app\wix\License.rtf'
                            KeyPath='yes'/>
                    </Component>

                    <Directory Id='Bin' Name='bin'>
                        <!-- The backend HTTP listener (scorpion-api.exe). Never
                             launched directly from a shortcut - only the
                             launcher spawns it, after resolving the
                             application-data directory and configuring
                             SCORPION_DOMAIN_DB for it. -->
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='scorpion-api.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\scorpion-api.exe'
                                KeyPath='yes'/>
                        </Component>
                        <!-- The thin GUI-subsystem startup orchestrator
                             (scorpion-launcher.exe). This is the file every
                             shortcut below targets. -->
                        <Component Id='binary1' Guid='*'>
                            <File
                                Id='exe1'
                                Name='scorpion-launcher.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\scorpion-launcher.exe'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>

            <!-- Start Menu entry: "Scorpion" folder containing one shortcut,
                 launching scorpion-launcher.exe (never scorpion-api.exe
                 directly, never a terminal command). -->
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='Scorpion'/>
            </Directory>

            <!-- Desktop shortcut, same target as the Start Menu entry. -->
            <Directory Id='DesktopFolder' Name='Desktop'/>
        </Directory>

        <DirectoryRef Id='ApplicationProgramsFolder'>
            <Component Id='ApplicationStartMenuShortcut' Guid='BE7DFF44-8B28-494B-8DC6-E2CED9B88B5B'>
                <Shortcut Id='StartMenuShortcut'
                    Name='Scorpion'
                    Description='Start Scorpion and open the Web Console'
                    Target='[#exe1]'
                    WorkingDirectory='Bin'/>
                <RemoveFolder Id='CleanUpStartMenuShortcut' Directory='ApplicationProgramsFolder' On='uninstall'/>
                <!-- A Shortcut cannot itself be a Component's KeyPath; this
                     per-user registry value is the standard WiX pattern for
                     giving a shortcut-only component a real KeyPath, and
                     lets Windows Installer correctly track its per-user
                     install state and repair/uninstall it. It stores no
                     application configuration of its own. -->
                <RegistryValue Root='HKCU' Key='Software\Scorpion' Name='StartMenuShortcutInstalled' Type='integer' Value='1' KeyPath='yes'/>
            </Component>
        </DirectoryRef>

        <DirectoryRef Id='DesktopFolder'>
            <Component Id='ApplicationDesktopShortcut' Guid='34894FE2-19A4-4F93-AD21-82BFEF36A609'>
                <Shortcut Id='DesktopShortcut'
                    Name='Scorpion'
                    Description='Start Scorpion and open the Web Console'
                    Target='[#exe1]'
                    WorkingDirectory='Bin'/>
                <RegistryValue Root='HKCU' Key='Software\Scorpion' Name='DesktopShortcutInstalled' Type='integer' Value='1' KeyPath='yes'/>
            </Component>
        </DirectoryRef>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs Scorpion (the local backend and the launcher), the license, and Start Menu/Desktop shortcuts.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <!--
              Comment out or remove the following `ComponentRef` tag to remove
              the license sidecar file from the installer.
            -->
            <ComponentRef Id='License'/>

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='binary1'/>
            <ComponentRef Id='ApplicationStartMenuShortcut'/>
            <ComponentRef Id='ApplicationDesktopShortcut'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>


        <!--
          Uncomment the following `Icon` and `Property` tags to change the product icon.

          The product icon is the graphic that appears in the Add/Remove
          Programs control panel for the application.

          No custom .ico asset exists in this repository as of this
          frontier (SCORPION_WINDOWS_INSTALLABLE_APPLICATION_001) - adding
          one was out of this frontier's scope (it would be a fabricated
          visual asset with no owner-provided source). The installer and
          shortcuts use the executables' own default icon until an owner
          supplies a real one.
        -->
        <!--<Icon Id='ProductICO' SourceFile='scorpion_app\wix\Product.ico'/>-->
        <!--<Property Id='ARPPRODUCTICON' Value='ProductICO' />-->

        <Property Id='ARPHELPLINK' Value='https://github.com/Agentxx7/scorpion-rs'/>

        <UI>
            <UIRef Id='WixUI_Minimal'/>
        </UI>

        <!--
          Disabling the EULA dialog in the installer requires commenting out
          or removing the following `WixVariable` tag
        -->
        <WixVariable Id='WixUILicenseRtf' Value='scorpion_app\wix\License.rtf'/>


        <!--
          Uncomment the next `WixVariable` tag to customize the installer's
          Graphical User Interface (GUI) and add a custom banner image across
          the top of each screen. See the WiX Toolset documentation for details
          about customization.

          The banner BMP dimensions are 493 x 58 pixels.
        -->
        <!--<WixVariable Id='WixUIBannerBmp' Value='scorpion_app\wix\Banner.bmp'/>-->


        <!--
          Uncomment the next `WixVariable` tag to customize the installer's
          Graphical User Interface (GUI) and add a custom image to the first
          dialog, or screen. See the WiX Toolset documentation for details about
          customization.

          The dialog BMP dimensions are 493 x 312 pixels.
        -->
        <!--<WixVariable Id='WixUIDialogBmp' Value='scorpion_app\wix\Dialog.bmp'/>-->

    </Product>

</Wix>
